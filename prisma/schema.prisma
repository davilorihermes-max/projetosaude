// Fechamento Financeiro Consolidado (Mensal, Decendial, Semanal)
model FinancialSettlement {
  id               String           @id @default(cuid())
  professionalId   String
  professional     Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  periodType       String           @default("MONTHLY") // "MONTHLY", "DECENDIAL", "WEEKLY"
  periodStart      DateTime
  periodEnd        DateTime
  totalSessions    Int              @default(0)
  totalGrossAmount Float            @default(0.0)
  status           String           @default("DRAFT") // "DRAFT", "PENDING_REVIEW", "APPROVED", "PAID", "CANCELLED"
  approvedAt       DateTime?
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  items            SettlementItem[]

  @@index([professionalId, periodStart, periodEnd])
}

// Snapshots Imutáveis dos Atendimentos Faturados
model SettlementItem {
  id                  String              @id @default(cuid())
  settlementId        String
  settlement          FinancialSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  appointmentId       String              @unique
  appointment         Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientNameSnapshot String
  addressSnapshot     String
  executedAt          DateTime
  chargedAmount       Float
  createdAt           DateTime            @default(now())

  @@index([settlementId])
}

model ScalePlannerConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

