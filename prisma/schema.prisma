// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("PROFESSIONAL") // "ADMIN", "PROFESSIONAL", "PATIENT"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  professional Professional?
}

model Professional {
  id           String           @id @default(cuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  crm          String
  specialty    String
  latitude     Float?
  longitude    Float?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  careTeams    CareTeamMember[]
  appointments Appointment[]
  attendances  Attendance[]
}

model Patient {
  id              String           @id @default(cuid())
  name            String
  cpf             String           @unique
  email           String?
  phone           String?
  latitude        Float
  longitude       Float
  address         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  careTeamMembers CareTeamMember[]
  appointments    Appointment[]
  attendances     Attendance[]
}

model CareTeamMember {
  id             String       @id @default(cuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  role           String       @default("PRIMARY_CARE") // "PRIMARY_CARE", "SPECIALIST", "NURSE"
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([patientId, professionalId])
}

model Appointment {
  id              String       @id @default(cuid())
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scheduledTime   DateTime
  durationMinutes Int          @default(45)
  status          String       @default("SCHEDULED") // "SCHEDULED", "IN_PROGRESS", "COMPLETED", "CANCELLED"
  latitude        Float?
  longitude       Float?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  attendance      Attendance?
}

model Attendance {
  id                    String        @id @default(cuid())
  appointmentId         String        @unique
  appointment           Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  professionalId        String
  professional          Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId             String
  patient               Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  checkInAt             DateTime      @default(now())
  checkInLatitude       Float?
  checkInLongitude      Float?
  checkInDistanceMeters Float?
  checkInStatus         String        @default("ON_SITE_VALIDATED") // "ON_SITE_VALIDATED", "OUT_OF_BOUNDS_ACCEPTED", "MANUAL_OVERRIDE"
  overrideReason        String?
  checkOutAt            DateTime?
  checkOutLatitude      Float?
  checkOutLongitude     Float?
  actualDurationMin     Int?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([appointmentId])
  @@index([professionalId])
  @@index([patientId])
}
