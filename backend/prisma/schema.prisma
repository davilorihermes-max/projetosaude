datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  ADMIN                    // Gestor de Escala / Administrador Geral
  PROFESSIONAL             // Profissional de Saúde (Escala ou Autônomo)
  PATIENT_REPRESENTATIVE   // Paciente ou Responsável Legal (Apenas Leitura)
}

enum ScheduleType {
  INSTITUTIONAL_SCALE      // Gerado pela escala institucional da clínica
  AUTONOMOUS_APPOINTMENT   // Agendado diretamente pelo profissional autônomo
}

enum ScheduleStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_PROFESSIONAL
  NO_SHOW
}

enum CheckInStatus {
  ON_SITE_VALIDATED        // Dentro do raio de geofencing (ex: < 150m)
  OUT_OF_BOUNDS_ACCEPTED   // Fora do raio, com justificativa aceita
  MANUAL_OVERRIDE          // Registrado manualmente por autorização
}

enum SettlementStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PAID
  CANCELLED
}

enum SettlementPeriodType {
  WEEKLY
  DECENDIAL                // Decendial (10 em 10 dias)
  MONTHLY
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  fullName      String         @map("full_name") @db.VarChar(255)
  phone         String?        @db.VarChar(30)
  role          UserRole       @default(PROFESSIONAL)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  professional  Professional?
  patients      Patient[]      @relation("UserPatientAccount")

  @@map("users")
}

model Professional {
  id                          String                @id @default(uuid()) @db.Uuid
  userId                      String                @unique @map("user_id") @db.Uuid
  user                        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  councilType                 String                @map("council_type") @db.VarChar(50) // ex: CREFITO, CRF, CRP
  councilNumber               String                @map("council_number") @db.VarChar(50)
  specialization              String                @db.VarChar(100) // Fisioterapia Motora, Fonoaudiologia, etc.
  isIndependent               Boolean               @default(false) @map("is_independent") // Atua como autônomo sem escala
  colorHex                    String                @default("#3B82F6") @map("color_hex") @db.VarChar(7)
  createdAt                   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  careTeams                   CareTeamMember[]
  contextualPrices            ContextualPrice[]
  schedules                   Schedule[]
  attendances                 Attendance[]
  clinicalEvolutions          ClinicalEvolution[]
  financialSettlements        FinancialSettlement[]

  @@map("professionals")
}

model Patient {
  id                          String                @id @default(uuid()) @db.Uuid
  representativeUserId        String?               @map("representative_user_id") @db.Uuid
  representativeUser          User?                 @relation("UserPatientAccount", fields: [representativeUserId], references: [id])
  fullName                    String                @map("full_name") @db.VarChar(255)
  birthDate                   DateTime              @map("birth_date") @db.Date
  documentNumber              String?               @map("document_number") @db.VarChar(30)
  emergencyContact            String?               @map("emergency_contact") @db.VarChar(100)
  weeklySessionTarget         Int                   @default(2) @map("weekly_session_target")
  defaultSessionDurationMin   Int                   @default(60) @map("default_session_duration_min")
  
  // Anamnese Estruturada Clínica (Fonte de dados do RAG / IA)
  clinicalDiagnosis           String                @map("clinical_diagnosis") @db.Text
  mainComplaints              String                @map("main_complaints") @db.Text
  pathologyHistory            String?               @map("pathology_history") @db.Text
  functionalLimitations       String[]              @default([]) @map("functional_limitations")
  contraindications           String[]              @default([]) @map("contraindications")
  therapeuticGoals            String[]              @default([]) @map("therapeutic_goals")
  structuredAnamnesisExtra    Json                  @default("{}") @map("structured_anamnesis_extra") @db.JsonB
  anamnesisUpdatedAt          DateTime              @default(now()) @map("anamnesis_updated_at") @db.Timestamptz

  isActive                    Boolean               @default(true) @map("is_active")
  createdAt                   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  careTeam                    CareTeamMember[]
  addresses                   PatientAddress[]
  addressOverrides            PatientAddressOverride[]
  contextualPrices            ContextualPrice[]
  schedules                   Schedule[]
  attendances                 Attendance[]
  clinicalEvolutions          ClinicalEvolution[]

  @@map("patients")
}

// Tabela N:N Obrigatória - Restrição de Care Team
model CareTeamMember {
  id             String        @id @default(uuid()) @db.Uuid
  patientId      String        @map("patient_id") @db.Uuid
  professionalId String        @map("professional_id") @db.Uuid
  roleInTeam     String        @default("TITULAR") @map("role_in_team") @db.VarChar(50) // TITULAR, SUBSTITUTO, CONSULTOR
  isActive       Boolean       @default(true) @map("is_active")
  assignedAt     DateTime      @default(now()) @map("assigned_at") @db.Timestamptz

  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([patientId, professionalId])
  @@index([patientId, isActive])
  @@index([professionalId, isActive])
  @@map("patient_care_team")
}

model PatientAddress {
  id             String                    @id @default(uuid()) @db.Uuid
  patientId      String                    @map("patient_id") @db.Uuid
  label          String                    @db.VarChar(100) // "Casa Principal", "Clínica", "Escola"
  street         String                    @db.VarChar(255)
  number         String                    @db.VarChar(30)
  complement     String?                   @db.VarChar(100)
  neighborhood   String                    @db.VarChar(100)
  city           String                    @db.VarChar(100)
  state          String                    @db.VarChar(2)
  postalCode     String                    @map("postal_code") @db.VarChar(15)
  latitude       Decimal                   @db.Decimal(10, 8)
  longitude      Decimal                   @db.Decimal(11, 8)
  isDefault      Boolean                   @default(false) @map("is_default")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  patient        Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  overrides      PatientAddressOverride[]
  schedules      Schedule[]
  contextualPrices ContextualPrice[]

  @@index([patientId])
  @@map("patient_addresses")
}

// Calendário de Exceção para Endereço Ativo no Dia
model PatientAddressOverride {
  id             String         @id @default(uuid()) @db.Uuid
  patientId      String         @map("patient_id") @db.Uuid
  addressId      String         @map("address_id") @db.Uuid
  overrideDate   DateTime       @map("override_date") @db.Date
  reason         String?        @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  address        PatientAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@unique([patientId, overrideDate])
  @@index([patientId, overrideDate])
  @@map("patient_address_overrides")
}

// Tabela de Preços Contextuais: Profissional x Paciente x Endereço
model ContextualPrice {
  id             String          @id @default(uuid()) @db.Uuid
  professionalId String          @map("professional_id") @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  addressId      String?         @map("address_id") @db.Uuid
  pricePerSession Decimal        @map("price_per_session") @db.Decimal(10, 2)
  notes          String?         @db.VarChar(255)
  effectiveFrom  DateTime        @default(now()) @map("effective_from") @db.Date
  effectiveTo    DateTime?       @map("effective_to") @db.Date

  professional   Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  address        PatientAddress? @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@index([professionalId, patientId, addressId])
  @@map("contextual_prices")
}

model Schedule {
  id             String          @id @default(uuid()) @db.Uuid
  type           ScheduleType    @default(INSTITUTIONAL_SCALE)
  patientId      String          @map("patient_id") @db.Uuid
  professionalId String          @map("professional_id") @db.Uuid
  addressId      String          @map("address_id") @db.Uuid
  scheduledStart DateTime        @map("scheduled_start") @db.Timestamptz
  scheduledEnd   DateTime        @map("scheduled_end") @db.Timestamptz
  status         ScheduleStatus  @default(SCHEDULED)
  batchId        String?         @map("batch_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  patient        Patient         @relation(fields: [patientId], references: [id])
  professional   Professional    @relation(fields: [professionalId], references: [id])
  address        PatientAddress  @relation(fields: [addressId], references: [id])
  attendance     Attendance?

  @@index([professionalId, scheduledStart, scheduledEnd])
  @@index([patientId, scheduledStart])
  @@index([status])
  @@map("schedules")
}

model Attendance {
  id                   String             @id @default(uuid()) @db.Uuid
  scheduleId           String             @unique @map("schedule_id") @db.Uuid
  patientId            String             @map("patient_id") @db.Uuid
  professionalId       String             @map("professional_id") @db.Uuid
  
  checkInAt            DateTime           @map("check_in_at") @db.Timestamptz
  checkInLatitude      Decimal?           @map("check_in_latitude") @db.Decimal(10, 8)
  checkInLongitude     Decimal?           @map("check_in_longitude") @db.Decimal(11, 8)
  checkInDistanceMeters Decimal?          @map("check_in_distance_meters") @db.Decimal(8, 2)
  checkInStatus        CheckInStatus      @default(ON_SITE_VALIDATED) @map("check_in_status")

  checkOutAt           DateTime?          @map("check_out_at") @db.Timestamptz
  checkOutLatitude     Decimal?           @map("check_out_latitude") @db.Decimal(10, 8)
  checkOutLongitude    Decimal?           @map("check_out_longitude") @db.Decimal(11, 8)
  actualDurationMin    Int?               @map("actual_duration_min")

  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  schedule             Schedule           @relation(fields: [scheduleId], references: [id])
  patient              Patient            @relation(fields: [patientId], references: [id])
  professional         Professional       @relation(fields: [professionalId], references: [id])
  clinicalEvolution    ClinicalEvolution?
  settlementItem       SettlementItem?

  @@index([professionalId, checkInAt])
  @@index([patientId, checkInAt])
  @@map("attendances")
}

model ClinicalEvolution {
  id                 String       @id @default(uuid()) @db.Uuid
  attendanceId       String       @unique @map("attendance_id") @db.Uuid
  patientId          String       @map("patient_id") @db.Uuid
  professionalId     String       @map("professional_id") @db.Uuid
  
  rawNotes           String?      @map("raw_notes") @db.Text
  audioRecordingUrl  String?      @map("audio_recording_url") @db.VarChar(500)
  transcriptionText  String?      @map("transcription_text") @db.Text
  summarizedConduct  String       @map("summarized_conduct") @db.Text
  patientFeedback    String?      @map("patient_feedback") @db.Text
  nextSessionPlan    String?      @map("next_session_plan") @db.Text
  
  aiAssisted         Boolean      @default(false) @map("ai_assisted")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  attendance         Attendance   @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  patient            Patient      @relation(fields: [patientId], references: [id])
  professional       Professional @relation(fields: [professionalId], references: [id])

  @@index([patientId, createdAt])
  @@map("clinical_evolutions")
}

model CuratedExerciseProtocol {
  id                 String                      @id @default(uuid()) @db.Uuid
  specialization     String                      @db.VarChar(100)
  title              String                      @db.VarChar(255)
  targetCondition    String                      @map("target_condition") @db.VarChar(255)
  description        String                      @db.Text
  contraindications  String[]                    @default([])
  indications        String[]                    @default([])
  evidenceLevel      String?                     @map("evidence_level") @db.VarChar(50)
  content            String                      @db.Text
  embedding          Unsupported("vector(1536)")?
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  @@map("curated_exercise_protocols")
}

model FinancialSettlement {
  id                 String               @id @default(uuid()) @db.Uuid
  professionalId     String               @map("professional_id") @db.Uuid
  periodType         SettlementPeriodType @map("period_type")
  periodStart        DateTime             @map("period_start") @db.Date
  periodEnd          DateTime             @map("period_end") @db.Date
  totalSessions      Int                  @map("total_sessions")
  totalGrossAmount   Decimal              @map("total_gross_amount") @db.Decimal(10, 2)
  status             SettlementStatus     @default(DRAFT)
  approvedAt         DateTime?            @map("approved_at") @db.Timestamptz
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  professional       Professional         @relation(fields: [professionalId], references: [id])
  items              SettlementItem[]

  @@index([professionalId, periodStart, periodEnd])
  @@map("financial_settlements")
}

model SettlementItem {
  id                 String              @id @default(uuid()) @db.Uuid
  settlementId       String              @map("settlement_id") @db.Uuid
  attendanceId       String              @unique @map("attendance_id") @db.Uuid
  patientNameSnapshot String             @map("patient_name_snapshot") @db.VarChar(255)
  addressSnapshot    String              @map("address_snapshot") @db.VarChar(255)
  executedAt         DateTime            @map("executed_at") @db.Timestamptz
  chargedAmount      Decimal             @map("charged_amount") @db.Decimal(10, 2)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz

  settlement         FinancialSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  attendance         Attendance          @relation(fields: [attendanceId], references: [id])

  @@index([settlementId])
  @@map("settlement_items")
}
